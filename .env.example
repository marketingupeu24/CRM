# =====================================================================
#  Variables de entorno del CRM de leads
#  Nunca subas los archivos con claves reales a git.
# =====================================================================

# ---------------------------------------------------------------------
#  Secretos de la Edge Function "genesys" (NO van en un archivo .env)
#  Se guardan en Supabase con:  npx supabase secrets set NOMBRE=valor
#  SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente:
#  la service_role key nunca sale de Supabase.
# ---------------------------------------------------------------------
# Token que envían BuilderBot y el Apps Script en el header x-genesys-token
# GENESYS_BOT_TOKEN=genera_uno_con_node_crypto_randomBytes
# sombra = el Apps Script asigna y avisa | activo = Supabase asigna, avisa y envía recordatorios
# GENESYS_MODO=sombra
# API de BuilderBot Cloud para avisar al asesor (los mismos valores del Apps Script)
# BUILDERBOT_URL=https://.../messages
# BUILDERBOT_API_KEY=bb-xxxxxxxx

# ---------------------------------------------------------------------
#  panel/.env.local  (Next.js - se expone al navegador)
#  Solo la publishable key (o anon key). NUNCA la service_role / secret key.
#  Supabase > Project Settings > API Keys > "Publishable key"
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
